{
  "name": "Chinese Learning — Codex",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "node",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Character inventory",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--security-opt", "seccomp=unconfined"
  ],
  "mounts": [
    "source=chineselearn-codex-state,target=/home/node/.codex,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "remote.localPortHost": "localhost"
      }
    }
  },
  "postCreateCommand": "uv sync --locked && codex --version && uv run python --version && sqlite3 --version && git --version && rg --version"
}
