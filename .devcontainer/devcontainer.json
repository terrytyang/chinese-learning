{
  "name": "chineselearning",
  "build": { "dockerfile": "Dockerfile", "context": "." },
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/chineselearning",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/chineselearning,type=bind",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "chineselearning", "onAutoForward": "notify" } },
  "mounts": [
    "source=chineselearning-claude-state,target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-python.python"],
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  },
  "postCreateCommand": "uv sync --locked && claude --version"
}
